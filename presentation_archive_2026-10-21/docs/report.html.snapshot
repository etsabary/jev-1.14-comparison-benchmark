del="liquid_ultra" data-category="F01" data-correct="41" data-n="43" style="background:#12256d;color:#ffffff"><strong>41/43</strong><span>95.3%</span></td><td data-model="liquid_ultra" data-category="F02" data-correct="44" data-n="46" style="background:#12256d;color:#ffffff"><strong>44/46</strong><span>95.7%</span></td><td data-model="liquid_ultra" data-category="F03" data-correct="50" data-n="52" style="background:#102369;color:#ffffff"><strong>50/52</strong><span>96.2%</span></td><td data-model="liquid_ultra" data-category="F04" data-correct="51" data-n="54" style="background:#152772;color:#ffffff"><strong>51/54</strong><span>94.4%</span></td><td data-model="liquid_ultra" data-category="F05" data-correct="45" data-n="49" style="background:#1a2b7e;color:#ffffff"><strong>45/49</strong><span>91.8%</span></td><td data-model="liquid_ultra" data-category="F11" data-correct="35" data-n="41" style="background:#253b97;color:#ffffff"><strong>35/41</strong><span>85.4%</span></td></tr><tr><th scope="row">Amos 1 Large</th><td data-model="amos_large" data-category="F01" data-correct="40" data-n="43" style="background:#172978;color:#ffffff"><strong>40/43</strong><span>93.0%</span></td><td data-model="amos_large" data-category="F02" data-correct="44" data-n="46" style="background:#12256d;color:#ffffff"><strong>44/46</strong><span>95.7%</span></td><td data-model="amos_large" data-category="F03" data-correct="49" data-n="52" style="background:#152772;color:#ffffff"><strong>49/52</strong><span>94.2%</span></td><td data-model="amos_large" data-category="F04" data-correct="51" data-n="54" style="background:#152772;color:#ffffff"><strong>51/54</strong><span>94.4%</span></td><td data-model="amos_large" data-category="F05" data-correct="45" data-n="49" style="background:#1a2b7e;color:#ffffff"><strong>45/49</strong><span>91.8%</span></td><td data-model="amos_large" data-category="F11" data-correct="35" data-n="41" style="background:#253b97;color:#ffffff"><strong>35/41</strong><span>85.4%<