<!doctype html><html lang="en"><head><meta name="benchmark-presentation" content="october20-direct-additions-1342"><meta name="benchmark-cohort" content="october19-consolidated-1342"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>System 1 Decision Benchmark: 26 routes, 1342 questions</title><style>body{margin:0;color:#183044;background:#f5f8fa;font:16px/1.6 system-ui,-apple-system,sans-serif}main{max-width:1480px;margin:auto;padding:28px 32px 70px}header{background:#142f43;color:white;padding:38px 32px}header>div{max-width:1480px;margin:auto}h1{font-size:2.4rem;line-height:1.2;margin:.3em 0}h2{font-size:1.65rem;line-height:1.3;margin-top:1.3em}h3{font-size:1.1rem;margin-bottom:.2em}p{max-width:1150px}a{color:#006a85}header a{color:#c6f0ff}nav{display:flex;gap:22px;flex-wrap:wrap;margin-top:20px}.meta{color:#c1d5df}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:24px 0}.card{background:white;border:1px solid #d8e4eb;border-radius:10px;padding:18px}.big{font-size:1.7rem;font-weight:700}.label{font-size:.9rem;color:#51697c}.figure{background:white;border:1px solid #dce5eb;border-radius:10px;overflow:hidden;margin:24px 0}.figure img{width:100%;height:auto;display:block}.caption{font-size:.9rem;padding:10px 20px;color:#4c6475}.scroll{overflow:auto;background:white;border:1px solid #dce5eb;border-radius:8px;margin:20px 0;max-height:850px}table{border-collapse:collapse;width:100%;font-size:14px}th,td{text-align:right;padding:10px 12px;border-bottom:1px solid #e3e9ee;white-space:nowrap}th{position:sticky;top:0;background:#eaf1f5;z-index:1}td:nth-child(2),th:nth-child(2){text-align:left}td:first-child,th:first-child{text-align:left}tr:hover{background:#f1f6f8}.metric{padding:4px 7px;border-radius:4px;display:inline-block;font-weight:600;white-space:nowrap}.b0{background:#d8f1e8}.b1{background:#fff4c2}.b2{background:#ffe4ca}.b3{background:#fbdedd}.incomplete{border-bottom:2px dotted #9a6700}.legend{display:flex;gap:8px;flex-wrap:wrap;font-size:.9rem}.note{padding:16px 20px;background:#fff5df;border-left:4px solid #bc8a2e}.domain-definitions table td{white-space:normal;min-width:95px;vertical-align:top}.domain-definitions table td:nth-child(3),.domain-definitions table td:nth-child(4){min-width:240px;text-align:left}.domain-definitions table td:nth-child(6){min-width:190px;text-align:left}details{background:white;border:1px solid #dce5eb;border-radius:8px;padding:18px 22px;margin:20px 0}summary{font-weight:700;cursor:pointer}.downloads{display:flex;gap:20px;flex-wrap:wrap}.small{font-size:.9rem;color:#52687a}footer{margin-top:40px;border-top:1px solid #dce5eb;padding-top:18px}@media(max-width:800px){main{padding:20px 12px 50px}header{padding:26px 18px}h1{font-size:1.8rem}.cards{grid-template-columns:repeat(2,1fr)}.card{padding:12px}th,td{padding:8px;font-size:12px}}
main{max-width:1280px}.category-section{margin:44px 0 60px;scroll-margin-top:20px}.category-section>h3{font-size:1.65rem;margin-bottom:10px}.category-nav{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px, 1fr));gap:12px;margin:20px 0}.category-nav a{background:white;border:1px solid #cbdce5;padding:16px;border-radius:8px;line-height:1.4}.category-guide{background:#e9f2f6;padding:20px 24px;border-radius:8px}.category-guide li{margin:8px 0}.accuracy-legend{display:flex;gap:6px;flex-wrap:wrap;margin:16px 0}.accuracy-legend span{padding:6px 13px;border:1px solid #bacbd4;border-radius:4px}.category-matrix{overflow:auto;max-height:950px;border:1px solid #b7ccd8;border-radius:8px;background:white;margin:24px 0;isolation:isolate}.category-matrix table{width:100%;table-layout:fixed;font-size:16px;min-width:930px}.category-matrix th,.category-matrix td{padding:13px 10px;white-space:normal;text-align:center;vertical-align:middle}.category-matrix thead th{top:0;background:#e8f0f5;z-index:3;line-height:1.4;font-weight:650}.category-matrix thead small{display:block;font-size:13px;margin-top:8px;color:#405b6d}.category-matrix th:first-child{position:sticky;left:0;width:230px;text-align:left;background:#f0f5f8;z-index:2;border-right:2px solid #b7ccd8;overflow-wrap:anywhere}.category-matrix thead th:first-child{z-index:4}.category-matrix tbody th{font-weight:600;font-size:15px}.category-matrix td strong,.category-matrix td span{display:block}.category-matrix td strong{font-size:18px}.category-matrix td span{font-size:14px;margin-top:3px}.category-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin:25px 0}.category-card{background:white;border:1px solid #cedee8;border-top:4px solid #307d9c;border-radius:8px;padding:20px;scroll-margin-top:20px;min-width:0}.category-card h4{font-size:1.15rem;margin:0 0 8px}.category-card p{margin:10px 0}.category-meta{color:#536b7e;font-size:.9rem}.example{background:#f2f6f8;padding:12px;border-radius:4px}.category-card details{padding:12px;margin:15px 0 0}.ranked-category{overflow:auto}.ranked-category table{font-size:14px}.ranked-category th{white-space:normal;position:static}.ranked-category td{white-space:nowrap}.category-chart img{width:100%;max-width:1000px;display:block;margin:auto}.category-section>details{padding:14px 20px}.category-section>details summary{margin-bottom:10px}.category-section>p{max-width:1050px}@media(max-width:700px){.category-cards{grid-template-columns:1fr}.category-guide{padding:15px}.category-matrix th:first-child{width:170px}.category-matrix table{min-width:900px}.category-matrix tbody th{font-size:14px}.category-nav{grid-template-columns:1fr}.category-section>h3{font-size:1.35rem}.category-card{padding:16px}.category-section{margin:32px 0}.category-chart{overflow:auto}.category-chart img{min-width:830px}}
.llm-reference>th{background:#fff6d5}.native-addition>th{border-left:4px solid #1684ac}.free-note{background:#edf1f5;padding:16px;border-radius:6px}.addition-note{background:#eaf5fb;padding:20px;border-radius:8px}.cost-incomplete{text-decoration:underline;text-decoration-color:#b7770b;text-underline-offset:4px}</style></head><body><main><h1>System 1 Decision Benchmark</h1><p>23 specialized decision models and 3 high-end LLM references on the same 1342 text questions across 31 categories. Updated October 20, 2026.</p><nav><a href="#overview">Overall results</a><a href="#new-additions">October 20 additions</a><a href="#llm-references">LLM references</a><a href="#functions">Named categories</a><a href="#image-support">Image input</a><a href="#method">Method</a></nav><div class="cards"><div class="card"><div class="label">Leading decision model</div><div class="big">84.0%</div><div class="small">Respan Span-02 · 1127/1342</div></div><div class="card"><div class="label">Highest LLM reference score</div><div class="big">85.2%</div><div class="small">GPT-6 Sol, reasoning off · 1143/1342</div></div><div class="card"><div class="label">Complete matched coverage</div><div class="big">26 routes</div><div class="small">34,892 first attempts · 31 categories</div></div><div class="card"><div class="label">New direct providers</div><div class="big">3 additions</div><div class="small">d3-turbo · Amos Large · kettei-fat</div></div></div><section id="overview"><h2>Accuracy, speed and cost: all 26 routes</h2><p>Every row covers 1342 first decisions. Blue accuracy bars are specialized decision models; translucent pale yellow bars are no-reasoning LLM reference points.</p><div class="figure"><a href="direct_additions_2026-10-20/accuracy_speed_cost.svg"><img src="direct_additions_2026-10-20/accuracy_speed_cost.png" alt="All 26 routes: full-bank accuracy, median and p95 response latency, and metered cost"></a></div><div class="scroll"><table><thead><tr><th>Model</th><th>Type</th><th>Correct / questions</th><th>Median</th><th>p95</th><th>Cost / 1,000</th><th>Actual 1,342-question cost</th></tr></thead><tbody><tr class="llm-reference" data-summary-model="reference_sol"><th scope="row">GPT-6 Sol — no reasoning</th><td>LLM reference</td><td>1143/1342<br>85.2%</td><td style="background:#fbdedd">1023 ms</td><td style="background:#fbdedd">1546 ms</td><td class="" style="background:#fbdedd">$0.632112</td><td>$0.848294</td></tr><tr class="" data-summary-model="respan02"><th scope="row">Respan Span-02</th><td>Decision model</td><td>1127/1342<br>84.0%</td><td style="background:#d8f1e8">206 ms</td><td style="background:#fbdedd">2157 ms</td><td class="" style="background:#d8f1e8">$0.003537</td><td>$0.004746</td></tr><tr class="" data-summary-model="pplx_decider12"><th scope="row">Perplexity Decider v1.2</th><td>Decision model</td><td>1120/1342<br>83.5%</td><td style="background:#d8f1e8">249 ms</td><td style="background:#fff4c2">332 ms</td><td class="cost-incomplete" style="background:#d8f1e8">$0.007000 + ?</td><td>$0.009394 + ?</td></tr><tr class="" data-summary-model="nimble_v4_max"><th scope="row">Nimble v4 Max</th><td>Decision model</td><td>1115/1342<br>83.1%</td><td style="background:#d8f1e8">235 ms</td><td style="background:#fff4c2">329 ms</td><td class="" style="background:#ffe4ca">$0.027633</td><td>~$0.037084</td></tr><tr class="native-addition" data-summary-model="d3_turbo"><th scope="row">d3-turbo</th><td>Decision model</td><td>1106/1342<br>82.4%</td><td style="background:#d8f1e8">165 ms</td><td style="background:#fff4c2">298 ms</td><td class="" style="background:#edf1f5">Free public access*</td><td>Free public access*</td></tr><tr class="" data-summary-model="liquid_ultra"><th scope="row">Liquid d1-ultra</th><td>Decision model</td><td>1084/1342<br>80.8%</td><td style="background:#d8f1e8">200 ms</td><td style="background:#fff4c2">393 ms</td><td class="cost-incomplete" style="background:#fff4c2">$0.012124 + ?</td><td>$0.016270 + ?</td></tr><tr class="native-addition" data-summary-model="amos_large"><th scope="row">Amos 1 Large</th><td>Decision model</td><td>1074/1342<br>80.0%</td><td style="background:#fff4c2">311 ms</td><td style="background:#fff4c2">360 ms</td><td class="" style="background:#edf1f5">Free public access*</td><td>Free public access*</td></tr><tr class="llm-reference" data-summary-model="reference_sonnet"><th scope="row">Sonnet 5.5 — no thinking, JSON-choice</th><td>LLM reference</td><td>1070/1342<br>79.7%</td><td style="background:#fbdedd">1506 ms</td><td style="background:#fbdedd">2424 ms</td><td class="" style="background:#fbdedd">$1.433613</td><td>$1.923908</td></tr><tr class="native-addition" data-summary-model="kettei_fat"><th scope="row">kettei-fat</th><td>Decision model</td><td>1066/1342<br>79.4%</td><td style="background:#d8f1e8">174 ms</td><td style="background:#d8f1e8">214 ms</td><td class="" style="background:#fff4c2">$0.015433</td><td>$0.020711</td></tr><tr class="" data-summary-model="jev114"><th scope="row">Jev 1.14</th><td>Decision model</td><td>1030/1342<br>76.8%</td><td style="background:#d8f1e8">179 ms</td><td style="background:#fff4c2">269 ms</td><td class="" style="background:#fff4c2">$0.024571</td><td>$0.032974</td></tr><tr class="" data-summary-model="jev113"><th scope="row">Jev 1.13</th><td>Decision model</td><td>1026/1342<br>76.5%</td><td style="background:#d8f1e8">189 ms</td><td style="background:#fff4c2">323 ms</td><td class="" style="background:#fff4c2">$0.024571</td><td>$0.032974</td></tr><tr class="" data-summary-model="mercury_decide"><th scope="row">Mercury Decide</th><td>Decision model</td><td>1017/1342<br>75.8%</td><td style="background:#d8f1e8">238 ms</td><td style="background:#fff4c2">388 ms</td><td class="" style="background:#d8f1e8">$0.006956</td><td>$0.009334</td></tr><tr class="llm-reference" data-summary-model="reference_qwen"><th scope="row">Qwen3.8-Max — none, Hyper Charm</th><td>LLM reference</td><td>967/1342<br>72.1%</td><td style="background:#fbdedd">1191 ms</td><td style="background:#fbdedd">1731 ms</td><td class="cost-incomplete" style="background:#fbdedd">$0.614821 + ?</td><td>$0.825090 + ? quota</td></tr><tr class="" data-summary-model="liquid_d1"><th scope="row">Liquid d1</th><td>Decision model</td><td>965/1342<br>71.9%</td><td style="background:#d8f1e8">206 ms</td><td style="background:#ffe4ca">827 ms</td><td class="" style="background:#d8f1e8">$0.005773</td><td>$0.007748</td></tr><tr class="" data-summary-model="clef"><th scope="row">Cloudflare Clef</th><td>Decision model</td><td>936/1342<br>69.7%</td><td style="background:#fff4c2">268 ms</td><td style="background:#fff4c2">417 ms</td><td class="" style="background:#fff4c2">$0.017594</td><td>$0.023611</td></tr><tr class="" data-summary-model="pplx_flash12"><th scope="row">Perplexity Decider Flash v1.2</th><td>Decision model</td><td>923/1342<br>68.8%</td><td style="background:#d8f1e8">159 ms</td><td style="background:#d8f1e8">231 ms</td><td class="cost-incomplete" style="background:#d8f1e8">$0.003406 + ?</td><td>$0.004570 + ?</td></tr><tr class="" data-summary-model="microsoft_decision"><th scope="row">Microsoft-Decision-1</th><td>Decision model</td><td>921/1342<br>68.6%</td><td style="background:#fff4c2">283 ms</td><td style="background:#ffe4ca">566 ms</td><td class="" style="background:#fff4c2">$0.012237</td><td>$0.016422</td></tr><tr class="" data-summary-model="drex20"><th scope="row">Drex v2.0</th><td>Decision model</td><td>915/1342<br>68.2%</td><td style="background:#d8f1e8">232 ms</td><td style="background:#ffe4ca">755 ms</td><td class="cost-incomplete" style="background:#fff4c2">$0.016661 + ?</td><td>$0.022359 + ?</td></tr><tr class="" data-summary-model="clef_flash"><th scope="row">Cloudflare Clef Flash</th><td>Decision model</td><td>860/1342<br>64.1%</td><td style="background:#d8f1e8">245 ms</td><td style="background:#fff4c2">353 ms</td><td class="" style="background:#d8f1e8">$0.008797</td><td>$0.011806</td></tr><tr class="" data-summary-model="clef_omni"><th scope="row">Cloudflare Clef Omni</th><td>Decision model</td><td>860/1342<br>64.1%</td><td style="background:#d8f1e8">241 ms</td><td style="background:#fff4c2">400 ms</td><td class="cost-incomplete" style="background:#fbdedd">$0.061511 + ?</td><td>$0.082547 + ?</td></tr><tr class="" data-summary-model="drex15"><th scope="row">Drex v1.5</th><td>Decision model</td><td>853/1342<br>63.6%</td><td style="background:#d8f1e8">203 ms</td><td style="background:#ffe4ca">649 ms</td><td class="" style="background:#fff4c2">$0.011160</td><td>$0.014976</td></tr><tr class="" data-summary-model="kev4b"><th scope="row">Kev 4B</th><td>Decision model</td><td>822/1342<br>61.3%</td><td style="background:#d8f1e8">225 ms</td><td style="background:#fff4c2">377 ms</td><td class="" style="background:#fff4c2">$0.011718</td><td>$0.015725</td></tr><tr class="" data-summary-model="luna_decisions"><th scope="row">Luna 6 Decisions</th><td>Decision model</td><td>758/1342<br>56.5%</td><td style="background:#fff4c2">254 ms</td><td style="background:#ffe4ca">527 ms</td><td class="cost-incomplete" style="background:#ffe4ca">$0.035840 + ?</td><td>$0.048097 + ?</td></tr><tr class="" data-summary-model="tev1_4b_native"><th scope="row">Tev1 4B experimental (OpenRouter native adapter)</th><td>Decision model</td><td>751/1342<br>56.0%</td><td style="background:#d8f1e8">198 ms</td><td style="background:#fff4c2">253 ms</td><td class="" style="background:#fff4c2">$0.015657</td><td>$0.021011</td></tr><tr class="" data-summary-model="classify1"><th scope="row">ScaleDown Classify-1</th><td>Decision model</td><td>550/1342<br>41.0%</td><td style="background:#fff4c2">268 ms</td><td style="background:#fff4c2">362 ms</td><td class="" style="background:#fff4c2">$0.021388</td><td>$0.028703</td></tr><tr class="" data-summary-model="solar_flash"><th scope="row">Solar Decide Flash</th><td>Decision model</td><td>538/1342<br>40.1%</td><td style="background:#ffe4ca">540 ms</td><td style="background:#ffe4ca">747 ms</td><td class="cost-incomplete" style="background:#ffe4ca">$0.030203 + ?</td><td>$0.040532 + ?</td></tr></tbody></table></div><p class="free-note">*Free public access is not an API-reported $0 monetary charge or a guarantee of free production capacity. d3-turbo and Amos have a labelled free-access entry, not a numeric point on the logarithmic price axis. For metered routes, per-1000 costs are normalized from the actual 1342-question run; + ? preserves unreported charges. Qwen is a prepaid-quota valuation, not additional out-of-pocket billing.</p><details><summary>Fixed speed and cost color bands</summary><table><thead><tr><th>Band</th><th>Response time</th><th>Known cost per1,000</th></tr></thead><tbody><tr><th style="background:#d8f1e8">Green</th><td>≤250 ms</td><td>≤$0.010</td></tr><tr><th style="background:#fff4c2">Yellow</th><td>>250–500 ms</td><td>>$0.010–0.025</td></tr><tr><th style="background:#ffe4ca">Orange</th><td>>500–1,000 ms</td><td>>$0.025–0.050</td></tr><tr><th style="background:#fbdedd">Red</th><td>>1,000 ms</td><td>>$0.050</td></tr></tbody></table><p>Thresholds use unrounded values. Incomplete costs describe a known lower bound. The median, not p95, is the speed-screening measure.</p></details></section><section id="new-additions"><h2>October 20 additions: d3-turbo, Amos and kettei-fat</h2><div class="addition-note"><p>All 4026 first attempts returned valid decisions. No retries, refusals, probability-format warnings or provider failures occurred.</p><div class="scroll"><table><thead><tr><th>Model</th><th>Correct / questions</th><th>Average (mean)</th><th>Median</th><th>p95</th><th>Actual run cost</th></tr></thead><tbody><tr data-addition-model="d3_turbo"><th>d3-turbo</th><td>1106/1342 · 82.4%</td><td>181.9 ms</td><td>165.3 ms</td><td>297.8 ms</td><td>Free public access*</td></tr><tr data-addition-model="amos_large"><th>Amos 1 Large</th><td>1074/1342 · 80.0%</td><td>306.2 ms</td><td>310.7 ms</td><td>359.8 ms</td><td>Free public access*</td></tr><tr data-addition-model="kettei_fat"><th>kettei-fat</th><td>1066/1342 · 79.4%</td><td>179.4 ms</td><td>173.9 ms</td><td>213.6 ms</td><td>$0.020711</td></tr></tbody></table></div><p>New tests: October 20, 2026 (America/Toronto). Earlier 23-route measurements are unchanged. Response times exclude deliberate rate-limit waits.</p></div><h3>Three additions, the same leading group</h3><p>d3-turbo scored 1106/1342 (82.4%), fourth among the 23 specialized decision models. Span remains first at 1127, followed by Perplexity Decider at 1120 and Nimble Max at 1115. Amos Large scored 1074 (80.0%), sixth; kettei-fat scored 1066 (79.4%), seventh. These are observed scores on this developing bank, not a general intelligence ordering.</p><h3>Strong rule following does not imply strong state tracking</h3><p>d3-turbo and kettei-fat each answered all 46 if-then questions correctly; Amos answered 44. Checking required conditions produced 51/52, 49/52 and 50/52 respectively. On step-by-step procedures—applying each ordered edit to the current state—the scores were 20/48, 16/48 and 16/48. Span scored 33/48. All three newcomers returned valid decisions; their unsuccessful procedure answers were wrong choices, not formatting failures.</p><h3>Knowledge tracking and exact counting separate the newcomers</h3><p>On tracking what others know, d3-turbo scored 47/50, Amos 46/50 and kettei-fat 43/50, versus Span 41/50. These tasks ask, for example, where an observer will look after an object moved while they were absent. Exact truth counting—how many supplied claims are true—gave d3-turbo 35/71, Amos 37/71 and kettei-fat 19/71, versus Span 46/71. A similar overall score can conceal a large difference on one operation.</p><h3>kettei-fat has a different profile from its neighboring scores</h3><p>kettei-fat scored 45/50 on causal intervention, which asks what changes when a specified cause is forced to a new value; d3-turbo scored 38/50 and Amos 36/50. It also scored 56/58 on exceptions and priority rules and 43/43 on choosing authoritative current records. Its 19/71 exact truth-counting score is 26.8%, against a 20% random-choice baseline. The category profile is more useful than treating its 79.4% overall as one uniform ability.</p><h3>Scores near the Sonnet reference, at shorter response times</h3><p>Sonnet&#x27;s separately constrained, no-thinking reference scored 1070/1342 (79.7%). d3-turbo answered 36 more correctly, Amos four more and kettei-fat four fewer. Their medians were 165, 311 and 174 ms, versus Sonnet&#x27;s 1506 ms. These small Amos/Sonnet/kettei score gaps do not establish a reliable ordering. Sol remains the highest-scoring LLM reference at 1143/1342 (85.2%).</p><h3>Fast responses, separate public-access and metered prices</h3><p>The October 20 mean / median / p95 times were d3-turbo 182/165/298 ms, Amos 306/311/360 ms and kettei-fat 179/174/214 ms. All 4026 first attempts returned usable decisions, with no recoveries or probability-format warnings. d3-turbo and Amos used currently free public endpoints; no monetary charge was reported, so they are not plotted as a metered production price of zero. Sqwish reported $0.02071056 for all 1342 questions ($0.01543 per 1000). Its 30-request/minute starter limit stretched batch duration, not the measured response time. Different providers, dates, hardware and admission limits remain confounds.</p><h3>New image-capable candidates, not new image scores</h3><p>Current catalogs or author documentation declare image input for 16 of the 23 decision models, including Span-02, both Perplexity Deciders, both Liquid models and all three newcomers. The separate image benchmark has not changed. Text accuracy and latency do not establish image accuracy or image cost; the capability review records sources and distinguishes declared support from tested performance.</p></section><section id="llm-references"><h2>High-end LLM references, reasoning off</h2><h3>Decision models alongside high-end LLMs</h3><p>Respan Span-02 scored 1127/1342 (84.0%). The highest-scoring LLM reference was GPT-6 Sol — no reasoning: 1143/1342 (85.2%), a gap of 16 decisions. These are the same questions, facts and option order, with no tools or iterative repair. This measures System 1-style decision performance, not unrestricted reasoning or general intelligence.</p><h3>Sol and Span are close overall, with different strengths</h3><p>Sol scored 1143/1342 (85.2%), versus Span’s 1127 (84.0%). On the original 1136 questions, Sol scored 1014 and Span 1011; on the added 206, Sol scored 129 and Span 116. Sol answered 45/46 forward conditionals and 52/52 necessary-condition questions; Span answered 32/46 and 44/52. Span answered 33/48 sequential procedures and 55/74 truth-teller questions, versus Sol 18/48 and 38/74.</p><h3>Speed and cost separate otherwise nearby scores</h3><p>Sol’s median was 1023 ms, versus Span’s 206 ms: 5.0 times longer. Their recorded full-bank costs were $0.848294 and $0.00474628, a 179-fold difference. Span’s p95 was 2157 ms, versus Sol’s 1546 ms; the median advantage did not extend to that tail measure. These are route measurements, not controlled hardware comparisons.</p><h3>Sonnet needs a constrained decision format</h3><p>Sonnet’s JSON-choice run scored 1070/1342 (79.7%), at a 1506 ms median and $1.923908 for the bank. All 1342 outputs were valid and reported zero thinking tokens. In the separate bare-ID trial, 84 of 110 outputs were unusable explanations or truncated text. That trial is not pooled into this score. Sonnet scored 45/46 forward conditionals, 15/48 sequential procedures and 30/71 exact truth-counting questions.</p><h3>Qwen: decision accuracy and account limits</h3><p>Qwen3.8-Max delivered 967/1342 (72.1%); 1317 first attempts returned usable decisions, with 73.4% accuracy among those responses. There were 25 first-attempt provider/transport failures, retained in the primary score. It scored 38/46 on following if-then rules, 11/48 on step-by-step procedures and 30/74 on truth-teller consistency. Its median was 1191 ms and p95 1731 ms. Hyper Charm’s hourly limit produced some rejected requests; those are not labelled wrong model choices. Its cost is a prepaid-quota valuation, not additional cash billing. The requested none setting is documented in Hyper’s catalog, but the route does not report reasoning-token counts.</p><h3>What the comparison supports</h3><p>Span’s 84.0% sits between Sol’s 85.2% and Sonnet’s 79.7% on these immediate decisions, with much lower recorded cost and a shorter median response. The Qwen row adds a further reference point. Scores and error profiles differ by category. This is a selected reference group, not an exhaustive ranking of every LLM that can disable reasoning. Models that require thinking are outside this comparison. New eight-question categories remain coarse diagnostic samples, not reliability guarantees.</p><p>Sol: OpenRouter → OpenAI, standard. Sonnet: OpenRouter → Anthropic, between-tools mode with no tools, JSON-choice schema. Qwen: Hyper Charm, reasoning_effort=none. All use the same 16-token output cap; Sonnet’s JSON structure consumes more output tokens than a bare numeric ID. Sol and Sonnet responses are checked for explicit zero reasoning tokens. Qwen’s missing telemetry is not counted as zero.</p><p>Reasoning-off eligibility: <a href="https://developers.openai.com/api/docs/models/gpt-6-sol">OpenAI</a> · <a href="https://platform.claude.com/docs/en/build-with-claude/thinking-troubleshooting">Anthropic</a> · <a href="https://hyper.charm.land/v1/models">Hyper Charm catalog</a>.</p></section><section id="analysis"><h2>Earlier decision-model findings, unchanged measurements</h2><h3>What this measures</h3><p>One decision from supplied information, with five choices. No requested thinking budget, tools, explanation or iterative repair. This is System 1-style decision performance, not a comparison of unrestricted reasoning, writing or agentic work. The ranking uses every first attempt; provider failures count as unsuccessful delivered decisions and are not called wrong reasoning answers.</p><h3>Span leads the combined bank</h3><p>Span scored 1,127/1,342 (84.0%), Perplexity 1,120 (83.5%) and Nimble Max 1,115 (83.1%). The gaps are 7 and 12 answers. They are too small to establish a general intelligence ordering. Equal weighting of the 31 category percentages also puts Span first: 82.4%, versus Perplexity’s 79.4% and Nimble’s 79.0%. The main score remains question-weighted, so large categories contribute more questions.</p><h3>Typical speed and tail speed tell different stories</h3><p>Span’s median was 206 ms, with a 2.16-second p95. Perplexity’s median was 249 ms and p95 332 ms; Nimble’s were 235 and 329 ms. Span combines a short typical response with a much longer response-time tail. Its recorded cost is $0.00354 per 1,000 questions, versus $0.00700 plus one unreported attempt cost for Perplexity and approximately $0.02763 for Nimble. Span has the lowest metered cost among routes with complete charge accounting. The two new free public endpoints are a separate access category. All pooled medians are below two seconds. The exclusion policy uses median, not p95.</p><h3>Sequential state updates and truth counting remain discriminating</h3><p>Sequential procedures require applying ordered edits to the current state, such as reversing a row, swapping positions and moving an item. Span scored 33/48, Nimble 19/48, Perplexity 14/48 and Jev 1.14 7/48. For exact truth counting, which asks how many claims are true under the supplied facts, the same routes scored 46/71, 39/71, 43/71 and 28/71. Strong performance here still includes many wrong answers.</p><h3>The decision-model leader is not strongest in every function</h3><p>Forward conditionals ask what follows when facts activate chains of rules. Jev 1.14 scored 46/46, Perplexity and Nimble each 45/46, and Span 32/46. On truth-teller consistency, where whole statements must match each speaker’s type, Perplexity scored 58/74, Span 55/74 and Nimble 53/74. On one-to-one assignments, Perplexity scored 65/67 and Span 63/67; on belief tracking, Jev 1.13 scored 47/50 and Span 41/50. Belief tracking distinguishes what observers know from what actually happened.</p><h3>Uncertainty and system constraints change the functional picture</h3><p>Across the six uncertainty, strategy and system categories, Span scored 34/48, Perplexity 26/48, Nimble 25/48 and Jev 1.14 26/48. Span’s largest visible advantage is worst-case choices without supplied probabilities: 8/8, versus Perplexity 3/8, Nimble 4/8 and Jev 1.14 2/8. These require a worst-case action or policy, not an invented average. In information-flow security, Perplexity, Nimble and Jev 1.14 each scored 6/8, versus Span’s 5/8. Each category has eight questions. One answer changes its score by 12.5 percentage points; these are diagnostic profiles, not reliability guarantees.</p><h3>Jev, Luna and a lower-cost native alternative</h3><p>Jev 1.14 scored 1,030/1,342 (76.8%), Jev 1.13 1,026 (76.5%), and Luna Decisions 758 (56.5%). The Jev versions differ by 4 correct decisions overall. Assignments favor 1.14, 57/67 versus 54/67; causal intervention favors 1.13, 42/50 versus 38/50. The update is not a uniform improvement across functions. Mercury Decide scored 1,017 (75.8%), with a 238 ms median and $0.00696 per 1,000 at the captured prices. It scored 34/52 on swaps and 55/58 on priority rules, but 28/52 on necessary conditions, versus Jev 1.14’s 48/52. This is the native Mercury Decide route, not regular Mercury 2.5. The earlier LLM cohort lacks expanded coverage; the three new reference configurations above cover all 1,342 questions.</p></section><section id="functions"><h2>Category scores: what each task means</h2><p>All 31 categories are arranged into five reading groups. These groups organize the display only; they do not change the benchmark, its weighting or any score.</p><div class="category-guide"><h3>How to read these results</h3><ul><li>Read a row to compare one model across the named tasks. Read a column to compare models on one task.</li><li>Each cell gives <b>correct answers / questions</b>, followed by the percentage. For example, <b>6/8 · 75%</b> means six correct first decisions out of eight, not a confidence rating.</li><li>Darker blue means higher accuracy on the same fixed 0-100% scale throughout. Random guessing among five choices averages 20%. Percentages help compare differently sized categories; counts show the size of the evidence.</li><li>The model names stay visible when you scroll sideways. On a narrow screen, each explanation card also has an <b>All 26 routes</b> list with no wide matrix to decode.</li><li>Small categories are coarse: one answer changes an eight-question category by 12.5 percentage points. A perfect sampled score is not a reliability guarantee.</li></ul></div><nav class="category-nav" aria-label="Category groups"><a href="#group-rules">Rules and evidence<small> · 6 categories</small></a><a href="#group-ordering">Ordering, schedules and assignments<small> · 5 categories</small></a><a href="#group-state">Claims, changing state and perspectives<small> · 7 categories</small></a><a href="#group-causes">Causes, plans and exceptions<small> · 7 categories</small></a><a href="#group-uncertainty">Risk, strategy and system behavior<small> · 6 categories</small></a></nav><div class="accuracy-legend" aria-label="Fixed accuracy color scale"><span style="background:#ffffd9;color:#000000">0%</span><span style="background:#d6efb3;color:#000000">20%</span><span style="background:#73c8bd;color:#000000">40%</span><span style="background:#2498c1;color:#000000">60%</span><span style="background:#234da0;color:#ffffff">80%</span><span style="background:#081d58;color:#ffffff">100%</span></div><section class="category-section" id="group-rules"><h3>Rules and evidence</h3><p>Which facts meet a rule, which conclusions follow, and when is the evidence insufficient?</p><div class="category-matrix" tabindex="0" role="region" aria-label="Category scores; scroll horizontally on narrow screens"><table><thead><tr><th scope="col">Model</th><th scope="col"><a href="#category-F01">Lookup and filtering</a><small>43 questions</small></th><th scope="col"><a href="#category-F02">Following if-then rules</a><small>46 questions</small></th><th scope="col"><a href="#category-F03">Checking required conditions</a><small>52 questions</small></th><th scope="col"><a href="#category-F04">Combining AND, OR and NOT</a><small>54 questions</small></th><th scope="col"><a href="#category-F05">All, some, none and sets</a><small>49 questions</small></th><th scope="col"><a href="#category-F11">Enough evidence or a conflict?</a><small>41 questions</small></th></tr></thead><tbody><tr><th scope="row">GPT-6 Sol — no reasoning</th><td data-model="reference_sol" data-category="F01" data-correct="42" data-n="43" style="background:#0d2161;color:#ffffff"><strong>42/43</strong><span>97.7%</span></td><td data-model="reference_sol" data-category="F02" data-correct="45" data-n="46" style="background:#0d2161;color:#ffffff"><strong>45/46</strong><span>97.8%</span></td><td data-model="reference_sol" data-category="F03" data-correct="52" data-n="52" style="background:#081d58;color:#ffffff"><strong>52/52</strong><span>100.0%</span></td><td data-model="reference_sol" data-category="F04" data-correct="53" data-n="54" style="background:#0c2060;color:#ffffff"><strong>53/54</strong><span>98.1%</span></td><td data-model="reference_sol" data-category="F05" data-correct="46" data-n="49" style="background:#162874;color:#ffffff"><strong>46/49</strong><span>93.9%</span></td><td data-model="reference_sol" data-category="F11" data-correct="37" data-n="41" style="background:#1e2e85;color:#ffffff"><strong>37/41</strong><span>90.2%</span></td></tr><tr><th scope="row">Respan Span-02</th><td data-model="respan02" data-category="F01" data-correct="39" data-n="43" style="background:#1d2e83;color:#ffffff"><strong>39/43</strong><span>